+    pcCmd = kflcnRegRead_HAL(pGpu, pKernelFlcn, CMP50_FALCON_ICD_CMD);
+    pcData = kflcnRegRead_HAL(pGpu, pKernelFlcn, CMP50_FALCON_ICD_RDATA);
